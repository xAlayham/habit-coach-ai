# Anthropic API key for the coach agent
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Base URL of the habit-tracker-api instance the coach reads habits from
# local dev: http://127.0.0.1:8000
HABIT_API_BASE=https://your-habit-api.onrender.com

# JWT access token for the habit API (obtained from POST /users/login)
HABIT_API_TOKEN=your-access-token-here
